# .env.example 을 복사해 .env 를 만들고 실제 값으로 바꿔서 사용
#   cp .env.example .env

# ─────────────────────────────────────────────
# 1) 로컬 개발 (uv run uvicorn ...) 용 DB 접속 주소
#    Docker Compose로 실행할 때는 아래 POSTGRES_* 값으로 자동 생성한 주소가 우선한다.
# ─────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

# ─────────────────────────────────────────────
# 2) Docker Compose (EC2 배포) 용 DB 설정
#    비밀번호는 URL에 들어가므로 특수문자 없이: openssl rand -hex 24
# ─────────────────────────────────────────────
POSTGRES_USER=board
POSTGRES_PASSWORD=
POSTGRES_DB=board
API_PORT=80                  # 외부에서 접속할 포트 (EC2 보안 그룹에서도 열어야 함)

# DB 커넥션 풀
SQL_ECHO=false               # SQL 실행 로그 출력 여부 (개발 중에만 true 권장)
CONNECTION_POOL_SIZE=10      # 기본 생성될 연결 객체 수
CONNECTION_POOL_MAX_SIZE=20  # 최대 생성될 연결 객체 수

# 로거 설정
LOGGING_MODE=info            # debug / info
LOGGER_NAME=board-api

# JWT 설정 (openssl rand -hex 64 로 생성한 값 사용, 비어 있으면 서버가 시작되지 않음)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60  # 액세스 토큰 유효 시간(분)
